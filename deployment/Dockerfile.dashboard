# Multi-stage build: compile the React dashboard, then serve the static bundle
# behind a minimal nginx that proxies /api to the FastAPI service.
FROM node:22-alpine AS build
WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json ./
# npm ci (not install) so the lockfile is authoritative and reproducible.
RUN npm ci --no-fund --no-audit
COPY dashboard/ ./
RUN npm run build

FROM nginx:1.27-alpine
RUN rm /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY deployment/nginx/dashboard.conf /etc/nginx/conf.d/app.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
