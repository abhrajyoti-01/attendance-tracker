# ============================================================================
# Attendance Tracker - Environment Configuration
# Copy to .env and fill in real values. NEVER commit a populated .env.
# ============================================================================

# Environment: development | staging | production
# In production the app refuses to start unless JWT_SECRET below is set.
ENV=development
DEBUG=false

# ----------------------------------------------------------------------------
# Database (PostgreSQL; asyncpg driver)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://attendance:CHANGE_ME@localhost:5432/attendance
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ----------------------------------------------------------------------------
# Redis (rate limiting, Celery broker/backend)
# Set REDIS_PASSWORD in docker-compose deployments.
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# Authentication
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production startup FAILS if JWT_SECRET is missing or weak.
# ----------------------------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_RESET_TOKEN_EXPIRE_MINUTES=60

# Security toggles
SECURITY_REQUIRE_REDIS=false
SECURITY_DOCS_IN_PRODUCTION=false

# ----------------------------------------------------------------------------
# Model (FaceNet InceptionResnetV1 exported to ONNX)
# Produce with:  python scripts/export_pretrained_onnx.py --validate
# ----------------------------------------------------------------------------
MODEL_PATH=models/exported/embedding_net.onnx
DEVICE=cpu                      # cpu | cuda | mps
EMBEDDING_DIM=512               # must match the ONNX output dimension
FACE_IMAGE_SIZE=160
MATCH_THRESHOLD_DEFAULT=0.55    # cosine similarity threshold
MATCH_THRESHOLD_FLOOR=0.30      # lower bound accepted via API overrides

# Anti-spoofing (liveness) tuning
SPOOF_LIVENESS_THRESHOLD=0.67
SPOOF_BLINK_REQUIRED_WINDOW=3.0
SPOOF_NOSE_MOVEMENT_PX=12
SPOOF_TEXTURE_VARIANCE_MIN=15.0

# ----------------------------------------------------------------------------
# Object storage (MinIO / any S3-compatible). Required for async exports.
# ----------------------------------------------------------------------------
STORAGE_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=attendance-images
MINIO_EXPORT_BUCKET_NAME=attendance-exports
MINIO_USE_SSL=false
MINIO_PRESIGN_EXPIRY_SECONDS=3600

# ----------------------------------------------------------------------------
# API server
# ----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
MAX_UPLOAD_SIZE=10485760

# Rate limiting (defense in depth behind nginx)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_RECOGNITION_PER_MINUTE=60
RATE_LIMIT_PROD_ONLY=false

# CORS - comma separated origins; production rejects "*"
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                 # json | console

# ----------------------------------------------------------------------------
# Celery workers
# ----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Feature flags
ENABLE_FAISS_MATCHING=false
ENABLE_TRAINING=true
ENABLE_ASYNC_EXPORT=true
ENABLE_EMAIL=true
ENABLE_LIVE_FEED=true           # SSE live attendance feed (admin dashboard)

# Attendance behavior
ATTENDANCE_DEDUPE_WINDOW_MINUTES=10
DEFAULT_ORG_MAX_USERS=5000

# ----------------------------------------------------------------------------
# Email delivery (password reset links, invites).
# Password reset requires SMTP; without it reset requests log an ops error.
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Attendance Tracker
SMTP_USE_TLS=true
EMAIL_BASE_URL=http://localhost:3000   # frontend base URL used in email links

# Monitoring
PROMETHEUS_ENABLED=true
